# 닷홈 shared hosting — PHP 런타임 환경변수 예시
# 닷홈은 .env 자동 로드가 없음 → 아래 중 하나를 선택:
#   A) public/.htaccess 의 SetEnv 주석 해제 (권장)
#   B) config/database.php 등 파일에 직접 값 입력
#
# 도메인: https://study114.net (정본). 호환: https://www.study114.net, https://study114.dothome.co.kr
# 웹루트: /hosting/study114/html
# FTP 아이디: study114

STUDY114_API_BASE=https://study114.net
STUDY114_HOME_UI=https://study114.net
STUDY114_AUTH_UI=https://study114.net/auth
STUDY114_APP_ENV=production
STUDY114_DEBUG=0

STUDY114_DB_HOST=localhost
STUDY114_DB_PORT=3306
STUDY114_DB_NAME=study114
STUDY114_DB_USER=study114
STUDY114_DB_PASS=__DOTHOME_DB_PASSWORD__

# OAuth redirect (각 개발자 콘솔에 등록. 코드가 요청 origin으로 URI를 만듦)
# 정본:
# https://study114.net/api/auth/oauth/callback.php?provider=naver
# https://study114.net/api/auth/oauth/callback.php?provider=kakao
# https://study114.net/api/auth/oauth/callback.php?provider=google
# 호환(임시):
# https://www.study114.net/api/auth/oauth/callback.php?provider=naver|kakao|google
# https://study114.dothome.co.kr/api/auth/oauth/callback.php?provider=naver|kakao|google
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_KAKAO_REST_API_KEY=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

STUDY114_MAIL_FROM=noreply@study114.dothome.co.kr
STUDY114_CRON_KEY=__RANDOM_CRON_KEY__
STUDY114_STORAGE_SECRET=__RANDOM_STORAGE_SECRET__
