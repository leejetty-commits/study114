# study114 — 로컬 환경변수 이름만 (값은 비움). .env 는 커밋 금지.
# 복사: cp .env.example .env 후 로컬에서만 채운다.

# DB (docker-compose.dev 기본과 맞춤)
STUDY114_DB_HOST=
STUDY114_DB_PORT=
STUDY114_DB_NAME=
STUDY114_DB_USER=
STUDY114_DB_PASS=

# 앱
STUDY114_APP_ENV=
STUDY114_API_BASE=
STUDY114_HOME_UI=
STUDY114_AUTH_UI=

# 결제 전체 스위치. 비우면 꺼짐. 로컬·CI만 1. 운영 설정 금지.
STUDY114_PAYMENTS_ENABLED=

# 결제 mock 완료 게이트 (로컬·CI만 1). 운영 설정 금지.
STUDY114_PAID_MOCK_COMPLETE=

# 339 — 포트원 V2 + 토스 테스트 채널 (로컬 샌드박스)
# PG_PROVIDER=portone_test 일 때만 포트원. 미설정·다른 값이면 기존 dev_mock.
PG_PROVIDER=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
