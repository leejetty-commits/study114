# study114 — dothome minimal safe version

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 닷홈 기본 호스트만 정본으로. study114.net · www 는 조건에 안 걸림.
  RewriteCond %{HTTP_HOST} ^study114\.dothome\.co\.kr$ [NC]
  RewriteRule ^(.*)$ https://study114.net/$1 [R=301,L]

  # 실제 파일/디렉터리는 그대로 제공
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # PHP MVC 인증 라우트 (로그인·찾기만). 가입은 SPA 해시 라우트.
  RewriteRule ^auth/(login|logout|find-id|find-password)/?$ index.php [L,QSA]
  RewriteRule ^auth/signup/basic/?$ /auth/#/signup/basic [R=302,NE,L]
  RewriteRule ^auth/signup/complete/?$ /auth/#/signup/complete [R=302,NE,L]
  RewriteRule ^auth/signup/verify-email/?$ /auth/#/signup/verify-email [R=302,NE,L]
  RewriteRule ^auth/signup/terms/?$ /auth/#/signup/terms [R=302,NE,L]
  RewriteRule ^auth/signup/role/?$ /auth/#/signup/role [R=302,NE,L]
  RewriteRule ^auth/signup/form/?$ /auth/#/signup/form [R=302,NE,L]

  # SPA fallback
  RewriteRule ^auth/ auth/index.html [L]
  RewriteRule ^search/ search/index.html [L]
  RewriteRule ^register/room/ register/room/index.html [L]
  RewriteRule ^register/tutor/ register/tutor/index.html [L]

  # home-ui fallback
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ index.html [L]
</IfModule>

DirectoryIndex index.html index.php

# ---------------------------------------------------------------------------
# Cache headers (게스트 등록 SPA 접속장애 완화 1차 — 캐시 축만)
# - 해시 Vite 번들: 장기 immutable (배포 시 파일명 변경으로 구버전 충돌 없음)
# - HTML: 아래 운영 정책 유지. 완화 초안은 주석 블록 (미적용)
# 대상 의도 경로: /assets/index-*.{js,css}, /register/*/assets/index-*.{js,css}
#   (+ 동일 파일명 패턴의 /auth|/search 번들도 FilesMatch로 동일 적용)
# 비대상: 이미지·HTML·PHP·API·비해시 *.js/*.css
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # A. 해시 자산 — Vite 엔트리/청크 관례 `index-<hash>.js|css` 파일명만
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # B. SPA 엔트리 HTML — 현재 운영(유지). 배포 직후 새 JS 해시 연결 보장.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # B'. HTML 캐시 완화 초안 (미적용 — 승인·purge 절차 후 4차에서 교체)
  # 제안:
  #   Cache-Control: max-age=0, s-maxage=60, stale-while-revalidate=30
  #   (Pragma 제거 또는 생략)
  # 적용 시 필요: 배포마다 Cloudflare에서 SPA HTML 경로 purge
  #   (/, /index.html, /register/room/, /register/tutor/, /auth/, /search/ 등 엔트리)
  # 레포에 CF API 키·Actions 자동화는 넣지 않음. 운영자가 대시보드/수동 purge.
  # <FilesMatch "\.(html|htm)$">
  #   Header set Cache-Control "max-age=0, s-maxage=60, stale-while-revalidate=30"
  # </FilesMatch>
</IfModule>

# 운영 정본 URL: https://study114.net (미설정 시 127.0.0.1 폴백 → 소셜 로그인 오류 시 localhost로 튕김)
#
# [보안] OAuth 키·비밀값은 저장소에 커밋하지 않는다.
# 아래 __..__ placeholder는 배포(.github/workflows/deploy.yml)에서
# GitHub Actions Secrets 값으로 치환되어 서버 .htaccess에만 실값이 들어간다.
# (.htaccess 는 Apache가 HTTP로 직접 서빙하지 않으므로 서버 저장은 안전)
<IfModule mod_env.c>
  SetEnv STUDY114_API_BASE https://study114.net
  SetEnv STUDY114_HOME_UI https://study114.net
  SetEnv STUDY114_AUTH_UI https://study114.net/auth
  SetEnv STUDY114_APP_ENV production
  SetEnv STUDY114_DEBUG 0
  SetEnv STUDY114_MAIL_TRANSPORT resend
  SetEnv STUDY114_MAIL_FROM no-reply@study114.net
  SetEnv STUDY114_RESEND_API_KEY __STUDY114_RESEND_API_KEY__
  SetEnv STUDY114_MAIL_PROBE_KEY __STUDY114_MAIL_PROBE_KEY__
  SetEnv STUDY114_PHONE_OTP_PEPPER __STUDY114_PHONE_OTP_PEPPER__
  SetEnv OAUTH_NAVER_CLIENT_ID __OAUTH_NAVER_CLIENT_ID__
  SetEnv OAUTH_NAVER_CLIENT_SECRET __OAUTH_NAVER_CLIENT_SECRET__
  SetEnv OAUTH_KAKAO_REST_API_KEY __OAUTH_KAKAO_REST_API_KEY__
  SetEnv OAUTH_KAKAO_CLIENT_SECRET __OAUTH_KAKAO_CLIENT_SECRET__
  SetEnv OAUTH_GOOGLE_CLIENT_ID __OAUTH_GOOGLE_CLIENT_ID__
  SetEnv OAUTH_GOOGLE_CLIENT_SECRET __OAUTH_GOOGLE_CLIENT_SECRET__
</IfModule>
